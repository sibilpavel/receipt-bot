# Токен бота от @BotFather
BOT_TOKEN=123456:replace_me

# Публичный HTTPS-адрес сервиса (без слеша на конце)
BASE_URL=https://pay.example.com

# Секрет для подписи вебхуков платёжного провайдера
WEBHOOK_SECRET=change_me_long_random_string

# Отдельный секрет для подписи ссылок на чек и QR-кодов
LINK_SECRET=change_me_another_long_random_string

# Необязательно
DB_PATH=data/payments.db
TIMEZONE=Europe/Moscow

# Тестовый режим: сообщение боту вида "5 12345" (сумма в рублях, номер платежа)
# сразу создаёт платёж и присылает ссылку на чек. На проде оставьте выключенным.
TEST_MODE=0
